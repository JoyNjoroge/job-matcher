FLASK_ENV=production
FRONTEND_URL=https://your-frontend.example
OAUTH_REDIRECT_BASE=https://your-api.example/api

# Generate independent values of at least 32 random bytes.
SECRET_KEY=
JWT_SECRET_KEY=
FLASK_SECRET_KEY=

SUPABASE_URL=
# Server-only. Never expose this value through a VITE_* variable or extension.
SUPABASE_SERVICE_ROLE_KEY=
# Optional for local development; production requires the service-role key.
SUPABASE_ANON_KEY=

# AI provider. Keep the key server-side; never expose it to Vite or the extension.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional paid or pinned fallback model, e.g. openai/gpt-5.6-luna.
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_SITE_URL=https://your-frontend.example
OPENROUTER_APP_NAME=CandorApply
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Billing
PAYSTACK_SECRET_KEY=
PAYSTACK_SEEKER_PLAN_CODE=
PAYSTACK_PRO_PLAN_CODE=

# Job search providers
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=

# Maximum uploaded resume size (default: 10 MiB)
MAX_UPLOAD_BYTES=10485760
